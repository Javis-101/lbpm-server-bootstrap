# LBPM Server Bootstrap public example configuration.
# Copy to bootstrap.env and keep that private file out of Git.
STACK_DIR=/opt/lbpm-stack
DATA_MOUNT=/data
BOOTSTRAP_RUN_ROOT=/data/lbpm-bootstrap-runs
MPI_RANKS=1
VOXEL_LENGTH_UM=1.0
EXPECTED_RAW_NX=128
EXPECTED_RAW_NY=128
EXPECTED_RAW_NZ=128
FIRST_CASE_ID=validation-rock-001
# Optional: set only when the input artifact has an independently verified hash.
EXPECTED_FIRST_RAW_SHA256=
